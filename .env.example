# Production domain URL for canonical links, sitemaps, and OpenGraph
NEXT_PUBLIC_SITE_URL=https://digitalmarketingwithsid.com

# Agency notification email for contact inquiries
CONTACT_EMAIL=info@digitalmarketingwithsid.com
NEXT_PUBLIC_CONTACT_EMAIL=info@digitalmarketingwithsid.com

# Optional Email Provider API Key (e.g., Resend, Sendgrid, Postmark)
# When left empty, inquiries will be logged server-side in mock development mode
EMAIL_PROVIDER_API_KEY=

# Agency WhatsApp number in international format without spaces or symbols (e.g. 919876543210)
WHATSAPP_NUMBER=918447886310
NEXT_PUBLIC_WHATSAPP_NUMBER=918447886310

# Optional Web Analytics ID (e.g. Google Analytics / Plausible)
ANALYTICS_ID=

# Admin Dashboard Authentication Credentials
ADMIN_EMAIL=admin@digitalmarketingwithsid.com
ADMIN_PASSWORD=admin12345
ADMIN_SESSION_SECRET=digital_studio_admin_secret_key_super_secure_9921_sid
